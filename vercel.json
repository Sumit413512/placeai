{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "**": false
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://placeai-recovery.onrender.com",
      "permanent": false
    }
  ],
  "functions": {
    "app/app.py": {
      "includeFiles": "{app/templates/**,app/static/**}",
      "excludeFiles": "{tests/**,docs/**,alembic/**,scripts/**,.github/**,pages/**,*.md,index.html,PlaceAI_API.postman_collection.json,Dockerfile,docker-compose.yml}"
    }
  }
}
