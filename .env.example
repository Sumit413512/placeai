APP_NAME=PlaceAI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./placeai.db
AUTO_CREATE_SCHEMA=true
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
ALLOWED_ORIGINS=http://localhost:8000
# BASE_URL is the backend/runtime origin. PUBLIC_APP_URL is the stable user-facing frontend.
BASE_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:8000
# Optional compatibility alias used when PUBLIC_APP_URL is not set.
PASSWORD_RESET_BASE_URL=
UPLOAD_DIR=uploads/resumes
MAX_RESUME_MB=5
PUBLIC_RECRUITER_SIGNUP=false
ALLOW_TALENT_POOL_SEARCH=false
DEV_SHOW_RESET_TOKEN=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLIENT_ID=
# Transactional email. PlaceAI supports generic SMTP and Brevo aliases.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Optional Brevo aliases / HTTPS API fallback. Do not commit real secrets.
BREVO_SMTP_HOST=
BREVO_SMTP_USER=
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_SENDER_EMAIL=
BREVO_API_KEY=
ACCESS_REQUEST_NOTIFY_TO=
