APP_NAME=PlaceAI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./placeai.db
AUTO_CREATE_SCHEMA=true
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
ALLOWED_ORIGINS=http://localhost:8000
BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads/resumes
MAX_RESUME_MB=5
PUBLIC_RECRUITER_SIGNUP=false
ALLOW_TALENT_POOL_SEARCH=false
ENABLE_AI_DEMO_FALLBACK=false
DEV_SHOW_RESET_TOKEN=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
